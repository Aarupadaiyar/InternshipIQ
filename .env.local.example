# Frontend -> FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Resume parsing / OCR
GROQ_API_KEY=your-groq-api-key-here
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Browser OAuth client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id

# Backend-only values belong in backend/.env, not this browser-readable file:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/internshipiq
# SECRET_KEY=replace-with-a-long-random-secret
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_SECRET=your-github-client-secret
# RAZORPAY_KEY_ID=optional
# RAZORPAY_KEY_SECRET=optional
# RAZORPAY_WEBHOOK_SECRET=optional
# SMTP_HOST=optional
# SMTP_PORT=587
# SMTP_USER=optional
# SMTP_PASSWORD=optional
# SMTP_FROM=noreply@internshipiq.com
